<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsAsErrors>$(WarningsAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsAsErrors>
    <!-- NU1901-NU1904 mean a package has a known vulnerability and stay fatal.
         NU1900 means the audit service could not be reached, which is an
         infrastructure failure rather than a finding; TreatWarningsAsErrors
         would otherwise fail the build offline and report it as a code defect.
         It stays a visible warning, so a skipped audit is never silent. Never
         set NuGetAudit=false to get a green build; that disables the scan. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1900</WarningsNotAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <VersionPrefix>0.1.0</VersionPrefix>
    <Authors>Andrew Weeden and desk_Puff contributors</Authors>
    <Product>desk_Puff</Product>
    <RepositoryUrl>https://github.com/WeedenAndrew/desk_Puff</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>
