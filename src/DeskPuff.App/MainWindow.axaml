<Window x:Class="DeskPuff.App.MainWindow"
        x:CompileBindings="False"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:DeskPuff.App.Controls"
        Title="desk_Puff"
        Width="460"
        Height="760"
        MinWidth="460"
        MinHeight="760"
        WindowDecorations="None"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        TransparencyLevelHint="Transparent">
  <Window.Resources>
    <DataTemplate x:Key="ShortcutOptionTemplate">
      <TextBlock Text="{Binding Label}" Foreground="{DynamicResource TextBrush}" />
    </DataTemplate>
    <DataTemplate x:Key="DarkComboItemTemplate">
      <TextBlock Text="{Binding}" Foreground="{DynamicResource TextBrush}" />
    </DataTemplate>
  </Window.Resources>
  <Border Background="{DynamicResource WindowBrush}"
          BorderBrush="{DynamicResource BorderBrush}"
          BorderThickness="1"
          CornerRadius="20">
    <Viewbox Stretch="Uniform"
             StretchDirection="Both"
             HorizontalAlignment="Center"
             VerticalAlignment="Center">
      <Grid Width="458" Height="758">
      <Grid.RowDefinitions>
        <RowDefinition Height="46" />
        <RowDefinition Height="*" />
        <RowDefinition Height="78" />
      </Grid.RowDefinitions>

      <Grid x:Name="TitleBar"
            Grid.Row="0"
            Background="Transparent"
            PointerPressed="TitleBarPointerPressed">
        <Button AutomationProperties.AutomationId="SettingsNavButton"
                Command="{Binding ShowSettingsCommand}"
                Content="⚙"
                FontFamily="Segoe UI Symbol"
                FontSize="24"
                Width="42" Height="38" Padding="0"
                Margin="12,0,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Background="Transparent"
                BorderThickness="0"
                ToolTip.Tip="Settings" />
        <StackPanel Orientation="Horizontal"
                    Spacing="4"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Margin="0,0,4,0">
          <Border Background="{DynamicResource SubtleBrush}"
                  CornerRadius="8"
                  Padding="8,4"
                  VerticalAlignment="Center">
            <TextBlock Text="{Binding HeaderBadgeText}"
                      Foreground="{DynamicResource MutedBrush}"
                      FontSize="9"
                      FontWeight="SemiBold"
                      MaxWidth="132"
                      TextTrimming="CharacterEllipsis"
                      ToolTip.Tip="{Binding HeaderBadgeText}" />
          </Border>
          <Button Content="—" Click="MinimizeButtonClick"
                  Width="38" Height="38" Padding="3,3"
                  Background="Transparent" BorderThickness="0" FontSize="18" />
          <Button Content="X" Click="CloseButtonClick"
                  Width="38" Height="38" Padding="3,3"
                  Background="Transparent" BorderThickness="0" FontSize="18" />
        </StackPanel>
      </Grid>

      <Grid Grid.Row="1">
        <Grid IsVisible="{Binding ConnectionVisibility}"
              Margin="28,20,28,22">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid Grid.Row="0" HorizontalAlignment="Center" Margin="0,4,0,24">
            <Ellipse Width="92"
                     Height="92"
                     Stroke="{DynamicResource AccentBrush}"
                     StrokeThickness="2"
                     Opacity="0.9" />
            <Ellipse Width="68"
                     Height="68"
                     Stroke="#42514F"
                     StrokeThickness="1" />
            <TextBlock Text="P"
                       FontSize="34"
                       FontWeight="Light"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
          </Grid>
          <StackPanel Grid.Row="1" Margin="0,0,0,18">
            <TextBlock Text="CONNECT YOUR DEVICE"
                       HorizontalAlignment="Center"
                       FontSize="17"
                       FontWeight="SemiBold" />
            <TextBlock Text="App-enabled Puffco bases only"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource MutedBrush}"
                       FontSize="11"
                       Margin="0,6,0,0" />
          </StackPanel>
          <ListBox Grid.Row="2"
                   ItemsSource="{Binding Candidates}"
                   SelectedItem="{Binding SelectedCandidate}"
                   Background="{DynamicResource PanelBrush}"
                   BorderBrush="{DynamicResource BorderBrush}"
                   BorderThickness="1"
                   Padding="6"
                   Foreground="{DynamicResource TextBrush}">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" />
                  <TextBlock Grid.Column="1"
                             Text="{Binding SignalStrength, StringFormat={}{0} dBm}"
                             Foreground="{DynamicResource MutedBrush}"
                             FontSize="10" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <Grid Grid.Row="4" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0"
                    Content="SCAN AGAIN"
                    Command="{Binding ScanCommand}" />

            <!-- The status sits between the two buttons and is drawn twice,
                 once muted and once in the danger colour, with only one visible
                 at a time. Avalonia has no data trigger, and a converter or a
                 style class for a single colour swap costs more than the
                 duplicate line does. -->
            <TextBlock Grid.Column="1"
                       Text="{Binding StatusText}"
                       IsVisible="{Binding !StatusIsError}"
                       Foreground="{DynamicResource MutedBrush}"
                       FontSize="10"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"
                       Margin="10,0,10,0" />
            <TextBlock Grid.Column="1"
                       Text="{Binding StatusText}"
                       IsVisible="{Binding StatusIsError}"
                       Foreground="{DynamicResource DangerBrush}"
                       FontSize="10"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"
                       Margin="10,0,10,0" />

            <Button Grid.Column="2"
                    Content="CONNECT"
                    Command="{Binding ConnectCommand}"
                    Background="{DynamicResource AccentBrush}"
                    Foreground="{DynamicResource AccentForegroundBrush}"
                    BorderBrush="{DynamicResource AccentBrush}" />
          </Grid>
        </Grid>

        <Grid IsVisible="{Binding HomeVisibility}" Margin="22,0,22,12">
          <Grid.RowDefinitions>
            <RowDefinition Height="106" />
            <RowDefinition Height="*" />
            <RowDefinition Height="78" />
            <RowDefinition Height="64" />
          </Grid.RowDefinitions>

          <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="72" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="72" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
              <Rectangle Width="6" Height="18" RadiusX="2" RadiusY="2"
                         Fill="{DynamicResource AccentBrush}"
                         Opacity="{Binding BatteryBlockOneOpacity}" />
              <Rectangle Width="6" Height="18" RadiusX="2" RadiusY="2"
                         Fill="{DynamicResource AccentBrush}"
                         Opacity="{Binding BatteryBlockTwoOpacity}"
                         Margin="2,0,0,0" />
              <Rectangle Width="6" Height="18" RadiusX="2" RadiusY="2"
                         Fill="{DynamicResource AccentBrush}"
                         Opacity="{Binding BatteryBlockThreeOpacity}"
                         Margin="2,0,0,0" />
              <Rectangle Width="6" Height="18" RadiusX="2" RadiusY="2"
                         Fill="{DynamicResource AccentBrush}"
                         Opacity="{Binding BatteryBlockFourOpacity}"
                         Margin="2,0,0,0" />
              <TextBlock Text="{Binding BatteryText}"
                         FontSize="10"
                         Foreground="{DynamicResource MutedBrush}"
                         VerticalAlignment="Center"
                         Margin="6,0,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
              <TextBlock Text="{Binding DeviceName}"
                         FontSize="19"
                         FontWeight="SemiBold"
                         HorizontalAlignment="Center"
                         TextTrimming="CharacterEllipsis"
                         MaxWidth="240" />
              <TextBlock Text="{Binding VaporText}"
                         FontSize="10"
                         Foreground="{DynamicResource AccentBrush}"
                         FontWeight="SemiBold"
                         HorizontalAlignment="Center"
                         Margin="0,5,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="2"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
              <TextBlock Text="{Binding ChamberText}"
                         FontSize="9"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource MutedBrush}"
                         HorizontalAlignment="Center"
                         TextAlignment="Center"
                         TextWrapping="Wrap"
                         MaxWidth="70" />
            </StackPanel>
          </Grid>

          <Grid Grid.Row="1" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="64" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="64" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0"
                    Content="‹"
                    Command="{Binding PreviousProfileCommand}"
                    Width="52"
                    HorizontalAlignment="Center"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Height="52"
                    Padding="0"
                    FontSize="29"
                    Background="Transparent"
                    BorderThickness="0"
                    VerticalAlignment="Top"
                    Margin="0,89,0,0"
                    ToolTip.Tip="{Binding PreviousProfileShortcutText, StringFormat=Previous profile ({0})}" />

            <Grid Grid.Column="1" Width="260" Height="260" HorizontalAlignment="Center">
              <Button AutomationProperties.AutomationId="StartStopButton"
                      Width="226"
                      Height="226"
                      Padding="0"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Top"
                      Command="{Binding StartStopCommand}"
                      Background="{DynamicResource ScrollBarBrush}"
                      BorderBrush="{Binding ActiveProfileColor}"
                      BorderThickness="6">
                <Button.Template>
                  <ControlTemplate TargetType="Button">
                          <Grid>
                            <Ellipse x:Name="Outer"
                                     Fill="{TemplateBinding Background}"
                                     Stroke="{TemplateBinding BorderBrush}"
                                     StrokeThickness="1"
                                     Opacity="0.35" />
                            <!-- A slim lit tube: a soft bloom, a body, and a tight core, all
                                 four quadrants blending one colour into the next. The brushes
                                 are built in the view model because a gradient declared here
                                 cannot resolve bindings on its own stops. -->
                            <Path Data="M 113,10 A 103,103 0 0 1 216,113"
                                  Stroke="{Binding ProfileArcOne}"
                                  StrokeThickness="17"
                                  Opacity="0.16"
                                  IsHitTestVisible="False" />
                            <Path Data="M 216,113 A 103,103 0 0 1 113,216"
                                  Stroke="{Binding ProfileArcTwo}"
                                  StrokeThickness="17"
                                  Opacity="0.16"
                                  IsHitTestVisible="False" />
                            <Path Data="M 113,216 A 103,103 0 0 1 10,113"
                                  Stroke="{Binding ProfileArcThree}"
                                  StrokeThickness="17"
                                  Opacity="0.16"
                                  IsHitTestVisible="False" />
                            <Path Data="M 10,113 A 103,103 0 0 1 113,10"
                                  Stroke="{Binding ProfileArcFour}"
                                  StrokeThickness="17"
                                  Opacity="0.16"
                                  IsHitTestVisible="False" />
                            <Path Data="M 113,10 A 103,103 0 0 1 216,113"
                                  Stroke="{Binding ProfileArcOne}"
                                  StrokeThickness="9"
                                  Opacity="0.5"
                                  IsHitTestVisible="False" />
                            <Path Data="M 216,113 A 103,103 0 0 1 113,216"
                                  Stroke="{Binding ProfileArcTwo}"
                                  StrokeThickness="9"
                                  Opacity="0.5"
                                  IsHitTestVisible="False" />
                            <Path Data="M 113,216 A 103,103 0 0 1 10,113"
                                  Stroke="{Binding ProfileArcThree}"
                                  StrokeThickness="9"
                                  Opacity="0.5"
                                  IsHitTestVisible="False" />
                            <Path Data="M 10,113 A 103,103 0 0 1 113,10"
                                  Stroke="{Binding ProfileArcFour}"
                                  StrokeThickness="9"
                                  Opacity="0.5"
                                  IsHitTestVisible="False" />
                            <Path Data="M 113,10 A 103,103 0 0 1 216,113"
                                  Stroke="{Binding ProfileArcOne}"
                                  StrokeThickness="3"
                                  Opacity="1"
                                  IsHitTestVisible="False" />
                            <Path Data="M 216,113 A 103,103 0 0 1 113,216"
                                  Stroke="{Binding ProfileArcTwo}"
                                  StrokeThickness="3"
                                  Opacity="1"
                                  IsHitTestVisible="False" />
                            <Path Data="M 113,216 A 103,103 0 0 1 10,113"
                                  Stroke="{Binding ProfileArcThree}"
                                  StrokeThickness="3"
                                  Opacity="1"
                                  IsHitTestVisible="False" />
                            <Path Data="M 10,113 A 103,103 0 0 1 113,10"
                                  Stroke="{Binding ProfileArcFour}"
                                  StrokeThickness="3"
                                  Opacity="1"
                                  IsHitTestVisible="False" />
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                          </Grid>
                  </ControlTemplate>
                </Button.Template>
                <Grid Width="172" Height="172">
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding ProfileName}"
                               FontSize="15"
                               FontWeight="Bold"
                               Foreground="{Binding ProfileNameBrush}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding TemperatureText}"
                               FontSize="52"
                               FontWeight="Light"
                               HorizontalAlignment="Center"
                               Margin="0,1,0,0" />
                    <TextBlock Text="{Binding TemperatureCaption}"
                               FontSize="9"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource MutedBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,-5,0,7" />
                    <TextBlock Text="{Binding SessionTimeText}"
                               FontSize="23"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                    <!-- In the flow rather than pinned to the bottom: the name
                         and its caption made the stack tall enough to collide
                         with a bottom-aligned label, and the circle narrows too
                         sharply down there to hold one anyway. -->
                    <TextBlock Text="{Binding StartStopText}"
                               FontSize="10"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Margin="0,9,0,0" />
                  </StackPanel>
                </Grid>
              </Button>

              <TextBlock Text="SAVED PROFILE • NOT ON DEVICE"
                         IsVisible="{Binding SavedProfileCaptionVisibility}"
                         FontSize="10"
                         FontWeight="Bold"
                         Foreground="{DynamicResource AccentBrush}"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Bottom"
                         Margin="0,0,0,9" />
            </Grid>

            <Button Grid.Column="2"
                    Content="›"
                    Command="{Binding NextProfileCommand}"
                    Width="52"
                    HorizontalAlignment="Center"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Height="52"
                    Padding="0"
                    FontSize="29"
                    Background="Transparent"
                    BorderThickness="0"
                    VerticalAlignment="Top"
                    Margin="0,89,0,0"
                    ToolTip.Tip="{Binding NextProfileShortcutText, StringFormat=Next profile ({0})}" />
          </Grid>

          <Grid Grid.Row="2" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="154" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0"
                    AutomationProperties.AutomationId="TemperatureQuickHitButton"
                    Width="64"
                    Height="64"
                    Padding="0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Margin="0,0,7,0"
                    Command="{Binding BoostTemperatureCommand}"
                    ToolTip.Tip="{Binding TemperatureBoostShortcutText, StringFormat=Temperature boost ({0})}">
              <StackPanel VerticalAlignment="Center" Margin="0,0,0,3">
                <TextBlock Text="{Binding QuickTemperatureBoostText}"
                           FontSize="22"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center" />
                <TextBlock Text="TEMP"
                           FontSize="9"
                           Foreground="{DynamicResource MutedBrush}"
                           HorizontalAlignment="Center" />
              </StackPanel>
            </Button>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock Text="{Binding OperatingStateText}"
                         Foreground="{DynamicResource AccentBrush}"
                         FontSize="12"
                         FontWeight="SemiBold"
                         HorizontalAlignment="Center" />
              <TextBlock Text="{Binding StatusText}"
                         Foreground="{DynamicResource MutedBrush}"
                         FontSize="11"
                         TextAlignment="Center"
                         TextWrapping="Wrap"
                         MaxWidth="154"
                         Margin="0,4,0,0" />
            </StackPanel>
            <Button Grid.Column="2"
                    AutomationProperties.AutomationId="TimeQuickHitButton"
                    Width="64"
                    Height="64"
                    Padding="0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Margin="7,0,0,0"
                    Command="{Binding BoostTimeCommand}"
                    ToolTip.Tip="{Binding TimeBoostShortcutText, StringFormat=Time boost ({0})}">
              <StackPanel VerticalAlignment="Center" Margin="0,0,0,3">
                <TextBlock Text="{Binding QuickTimeBoostText}"
                           FontSize="21"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center" />
                <TextBlock Text="TIME"
                           FontSize="9"
                           Foreground="{DynamicResource MutedBrush}"
                           HorizontalAlignment="Center" />
              </StackPanel>
            </Button>
          </Grid>

          <Grid Grid.Row="3">
            <Border Height="44"
                    Width="414"
                    Margin="0,7,0,0"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Center"
                    Background="{DynamicResource SunkenBrush}"
                    CornerRadius="10" />
            <ListBox x:Name="HomeProfileStrip"
                     AutomationProperties.AutomationId="HomeProfileSelector"
                     ItemsSource="{Binding SelectableProfiles}"
                     SelectedItem="{Binding SelectedProfile, Mode=TwoWay}"
                     IsEnabled="{Binding CanEditDevice}"
                     Background="Transparent"
                     BorderThickness="0"
                     Padding="0"
                     Width="406"
                     Height="48"
                     Margin="0,7,0,0"
                     VerticalAlignment="Top"
                     HorizontalAlignment="Center"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                     ScrollViewer.AllowAutoHide="False">
              <ListBox.Styles>
                <!-- A hairline in the 4px the list has beyond the panel above
                     it, reading as an extension of the strip. The queue itself
                     is what you drag, so this does not need to be grabbable;
                     the thumb fills the lane so it sits flush, not floating. -->
                <Style Selector="ScrollBar:horizontal">
                  <Setter Property="Height" Value="4" />
                  <Setter Property="MinHeight" Value="4" />
                  <Setter Property="Margin" Value="0" />
                  <Setter Property="Padding" Value="0" />
                  <Setter Property="Background" Value="Transparent" />
                  <Setter Property="Cursor" Value="Hand" />
                </Style>
                <Style Selector="ScrollBar:horizontal /template/ RepeatButton#PART_LineUpButton">
                  <Setter Property="IsVisible" Value="False" />
                </Style>
                <Style Selector="ScrollBar:horizontal /template/ RepeatButton#PART_LineDownButton">
                  <Setter Property="IsVisible" Value="False" />
                </Style>
                <Style Selector="ScrollBar:horizontal /template/ Thumb">
                  <Setter Property="Margin" Value="0" />
                  <Setter Property="MinWidth" Value="28" />
                  <Setter Property="Cursor" Value="Hand" />
                </Style>
                <!-- The chip carries the profile's own colourway, so the theme's
                     flat accent highlight has to get out of the way. Selection
                     reads as full strength against dimmed neighbours. -->
                <Style Selector="ListBoxItem">
                  <Setter Property="Padding" Value="0" />
                  <Setter Property="Margin" Value="2,0" />
                  <Setter Property="MinWidth" Value="0" />
                  <Setter Property="MinHeight" Value="0" />
                  <Setter Property="Background" Value="Transparent" />
                  <Setter Property="CornerRadius" Value="8" />
                  <Setter Property="Opacity" Value="0.38" />
                  <Setter Property="Cursor" Value="Hand" />
                </Style>
                <Style Selector="ListBoxItem:selected">
                  <Setter Property="Opacity" Value="1" />
                </Style>
                <Style Selector="ListBoxItem:pointerover">
                  <Setter Property="Opacity" Value="0.75" />
                </Style>
                <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
                  <Setter Property="Background" Value="Transparent" />
                </Style>
                <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                  <Setter Property="Background" Value="Transparent" />
                </Style>
                <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                  <Setter Property="Background" Value="Transparent" />
                </Style>
              </ListBox.Styles>
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                  <VirtualizingStackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ListBox.ItemsPanel>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Border Width="97"
                          Height="34"
                          CornerRadius="8"
                          ClipToBounds="True"
                          Background="{Binding Gradient}">
                    <TextBlock Text="{Binding Name}"
                               FontSize="9"
                               FontWeight="Bold"
                               Foreground="{Binding ForegroundDisplay}"
                               TextTrimming="CharacterEllipsis"
                               Margin="4,0"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>
        </Grid>

        <ScrollViewer x:Name="ProfilesScroll" IsVisible="{Binding ProfilesVisibility}"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,8,0,12">
          <StackPanel Margin="24,0,24,12" Spacing="8">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel>
                <TextBlock Text="HEAT PROFILES" FontSize="19" FontWeight="SemiBold" />
                <TextBlock Text="Create and save locally. No device needed." FontSize="10" Foreground="{DynamicResource MutedBrush}" />
              </StackPanel>
              <Button Grid.Column="1" Content="NEW" Command="{Binding NewHeatingProfileCommand}" Padding="14,7" />
            </Grid>
            <TextBlock Text="JSON PROFILE NAME" FontSize="9" Foreground="{DynamicResource MutedBrush}" />
            <Grid ColumnDefinitions="*,8,Auto">
              <TextBox AutomationProperties.AutomationId="HeatingProfileNameEditor" Text="{Binding HeatingProfileName, UpdateSourceTrigger=PropertyChanged}" MaxLength="64" PlaceholderText="Name your heat profile" />
              <Button Grid.Column="2" AutomationProperties.AutomationId="SaveHeatingProfileButton" Content="SAVE HEAT JSON" Command="{Binding SaveHeatingProfileCommand}"
                      Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentForegroundBrush}" BorderBrush="{DynamicResource AccentBrush}" Padding="12,7" />
            </Grid>
            <TextBlock AutomationProperties.AutomationId="HeatingSaveValidation" Text="{Binding HeatingSaveValidation}" Foreground="{DynamicResource DangerBrush}" FontSize="10" TextWrapping="Wrap" />
            <Border Background="{DynamicResource PanelBrush}" CornerRadius="12" Padding="12">
              <StackPanel Spacing="9">
                <Grid ColumnDefinitions="*,12,*">
                  <StackPanel Spacing="4">
                    <TextBlock Text="{Binding TemperatureEditorLabel}" FontSize="9" Foreground="{DynamicResource MutedBrush}" />
                    <TextBox AutomationProperties.AutomationId="ProfileTemperatureEditor" Text="{Binding EditorTemperature, UpdateSourceTrigger=PropertyChanged}" />
                  </StackPanel>
                  <StackPanel Grid.Column="2" Spacing="4">
                    <TextBlock Text="SESSION TIME SEC" FontSize="9" Foreground="{DynamicResource MutedBrush}" />
                    <TextBox AutomationProperties.AutomationId="ProfileDurationEditor" Text="{Binding EditorDurationSeconds, UpdateSourceTrigger=PropertyChanged}" />
                  </StackPanel>
                </Grid>
                <Grid ColumnDefinitions="Auto,12,*">
                  <TextBlock Text="VAPOR" FontSize="9" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                  <ComboBox Grid.Column="2" ItemsSource="{Binding VaporLevels}" SelectedItem="{Binding EditorVapor}" ItemTemplate="{StaticResource DarkComboItemTemplate}" HorizontalAlignment="Stretch" />
                </Grid>
                <Button AutomationProperties.AutomationId="ProfileColorSelectorButton" Command="{Binding ShowColorCommand}" Background="Transparent" BorderThickness="0" Padding="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                  <StackPanel Spacing="5">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="{Binding CurrentColorProfileName}" FontSize="10" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="1" Text="EDIT COLORS ›" FontSize="9" Foreground="{DynamicResource AccentBrush}" />
                    </Grid>
                    <Border Height="14" CornerRadius="7" Background="{Binding EditorPaletteBrush}" />
                  </StackPanel>
                </Button>
                <Expander Header="Boost settings" HorizontalAlignment="Stretch">
                  <Grid ColumnDefinitions="*,12,*" Margin="0,6,0,0">
                    <StackPanel Spacing="4">
                      <TextBlock Text="{Binding BoostEditorLabel}" FontSize="9" Foreground="{DynamicResource MutedBrush}" />
                      <TextBox Text="{Binding EditorBoostTemperature, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="4">
                      <TextBlock Text="TIME BOOST SEC" FontSize="9" Foreground="{DynamicResource MutedBrush}" />
                      <TextBox Text="{Binding EditorBoostSeconds, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                  </Grid>
                </Expander>
              </StackPanel>
            </Border>
            <TextBlock Text="{Binding LocalProfileHint}" FontSize="9" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
            <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
              <TextBlock Text="SAVED HEAT JSON" FontSize="10" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
              <Button Grid.Column="1" Content="REFRESH" Command="{Binding ReloadLocalProfilesCommand}" Padding="10,5" FontSize="9" />
            </Grid>
            <ComboBox AutomationProperties.AutomationId="SavedHeatingProfilesSelector" ItemsSource="{Binding SavedHeatingProfiles}" SelectedItem="{Binding SelectedSavedHeatingProfile}" HorizontalAlignment="Stretch" PlaceholderText="No saved profiles yet">
              <ComboBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}" FontSize="11" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding DetailText}" FontSize="9" Foreground="{DynamicResource MutedBrush}" /></StackPanel></DataTemplate></ComboBox.ItemTemplate>
            </ComboBox>
            <Grid ColumnDefinitions="*,8,*">
              <Button Content="LOAD TO EDIT" Command="{Binding EditHeatingProfileCommand}" />
              <Button Grid.Column="2" AutomationProperties.AutomationId="ApplyHeatingProfileButton" Content="USE FOR SESSION" Command="{Binding ApplyHeatingProfileCommand}" />
            </Grid>
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="{Binding StatusText}" FontSize="10" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,10,0" />
              <Button Grid.Column="1" Content="DELETE" Command="{Binding DeleteHeatingProfileCommand}" Foreground="{DynamicResource DangerBrush}" Padding="10,5" FontSize="9" />
            </Grid>
            <Expander Header="Device slot &amp; shortcut" HorizontalAlignment="Stretch" Margin="0,4,0,0">
              <StackPanel Spacing="7" Margin="0,8,0,0">
                <TextBlock Text="Requires a connected, verified device. Local JSON saving stays independent." FontSize="10" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
                <TextBlock Text="DEVICE SLOT LABEL" FontSize="9" Foreground="{DynamicResource MutedBrush}" />
                <TextBox AutomationProperties.AutomationId="ProfileNameEditor" Text="{Binding EditorName, UpdateSourceTrigger=PropertyChanged}" MaxLength="31" />
                <Button Content="WRITE DEVICE SLOT" Command="{Binding SaveProfileCommand}" />
                <Grid ColumnDefinitions="*,8,Auto">
                  <ComboBox ItemsSource="{Binding ProfileMacroOptions}" ItemTemplate="{StaticResource ShortcutOptionTemplate}" SelectedValue="{Binding EditorProfileMacroKey}" />
                  <Button Grid.Column="2" Content="SAVE MACRO" Command="{Binding SavePreferencesCommand}" Padding="12,7" />
                </Grid>
                <TextBlock Text="Shortcut selects the slot from Home while idle; it never starts heat." FontSize="9" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
              </StackPanel>
            </Expander>
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="ColorsScroll" IsVisible="{Binding ColorVisibility}"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,8,0,12">
          <StackPanel Margin="24,0,24,12" Spacing="8">
            <TextBlock Text="COLORWAYS" FontSize="19" FontWeight="SemiBold" />
            <TextBlock Text="Create colors locally, then pair them with a heat profile." FontSize="10" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
            <Grid ColumnDefinitions="*,8,Auto">
              <TextBox AutomationProperties.AutomationId="PaletteNameEditor" Text="{Binding PaletteName, UpdateSourceTrigger=PropertyChanged}" MaxLength="64" PlaceholderText="Name your colorway" />
              <Button Grid.Column="2" AutomationProperties.AutomationId="SaveColorPaletteButton" Content="SAVE COLOR JSON" Command="{Binding SaveColorPaletteCommand}" Padding="12,7" />
            </Grid>
            <TextBlock Text="{Binding ColorSaveValidation}" Foreground="{DynamicResource DangerBrush}" FontSize="10" TextWrapping="Wrap" />
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="{Binding CurrentColorProfileName}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Column="1" Text="{Binding ColorStopPositionText}" FontSize="9" Foreground="{DynamicResource AccentBrush}" />
            </Grid>
            <Border Height="16" CornerRadius="8" Background="{Binding EditorPaletteBrush}" PointerPressed="ColorRampPointerPressed" ToolTip.Tip="Select the nearest color stop" />
            <Grid Height="166" ColumnDefinitions="48,*,48">
              <Button Content="‹" Command="{Binding PreviousColorStopCommand}" Width="40" Height="52" Padding="0" FontSize="25" Background="Transparent" BorderThickness="0" VerticalAlignment="Center" ToolTip.Tip="Previous color stop" />
              <controls:ColorWheelPicker Grid.Column="1" Width="142" Height="160" HorizontalAlignment="Center" SelectedColor="{Binding WheelColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
              <Button Grid.Column="2" Content="›" Command="{Binding NextColorStopCommand}" Width="40" Height="52" Padding="0" FontSize="25" Background="Transparent" BorderThickness="0" VerticalAlignment="Center" ToolTip.Tip="Next color stop" />
            </Grid>
            <Grid ColumnDefinitions="*,8,*">
              <Button Content="REMOVE STOP" Command="{Binding RemoveColorStopCommand}" />
              <Button Grid.Column="2" Content="ADD STOP" Command="{Binding AddColorStopCommand}" />
            </Grid>
            <Button AutomationProperties.AutomationId="UseColorWithHeatingProfileButton" Content="USE WITH HEAT PROFILE" Command="{Binding UseColorWithHeatingProfileCommand}"
                    Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentForegroundBrush}" BorderBrush="{DynamicResource AccentBrush}" />
            <TextBlock Text="{Binding LocalProfileHint}" FontSize="9" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="SAVED COLOR JSON" FontSize="10" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
              <Button Grid.Column="1" Content="REFRESH" Command="{Binding ReloadLocalProfilesCommand}" Padding="10,5" FontSize="9" />
            </Grid>
            <ComboBox AutomationProperties.AutomationId="SavedColorProfilesSelector" ItemsSource="{Binding SavedColorPalettes}" SelectedItem="{Binding SelectedSavedColorPalette}" HorizontalAlignment="Stretch" PlaceholderText="No saved colorways yet">
              <ComboBox.ItemTemplate><DataTemplate><Grid ColumnDefinitions="*,80"><TextBlock Text="{Binding Name}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" /><Border Grid.Column="1" Height="12" CornerRadius="6" Background="{Binding Gradient}" /></Grid></DataTemplate></ComboBox.ItemTemplate>
            </ComboBox>
            <Grid ColumnDefinitions="*,8,*">
              <Button AutomationProperties.AutomationId="ApplyColorPaletteButton" Content="LOAD COLORS" Command="{Binding ApplyColorPaletteCommand}" />
              <Button Grid.Column="2" Content="DELETE" Command="{Binding DeleteColorPaletteCommand}" Foreground="{DynamicResource DangerBrush}" />
            </Grid>
            <TextBlock Text="{Binding StatusText}" FontSize="10" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
            <Expander Header="Device slot colors" HorizontalAlignment="Stretch">
              <StackPanel Spacing="6" Margin="0,6,0,0">
                <TextBlock Text="{Binding ColorPageContextText}" FontSize="10" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
                <Button AutomationProperties.AutomationId="SaveProfileColorButton" Content="WRITE DEVICE SLOT" Command="{Binding SaveProfileCommand}" />
              </StackPanel>
            </Expander>
          </StackPanel>
        </ScrollViewer>
        <ScrollViewer IsVisible="{Binding SettingsVisibility}"
                      VerticalScrollBarVisibility="Auto"
                      Margin="0,8,0,18">
          <StackPanel Margin="28,0,28,0">
            <TextBlock Text="DEVICE &amp; SAFETY"
                       FontSize="19"
                       FontWeight="SemiBold" />
            <TextBlock Text="Local controls, no account or cloud connection."
                       Foreground="{DynamicResource MutedBrush}"
                       FontSize="10"
                       Margin="0,5,0,18" />

            <Border Background="{DynamicResource PanelBrush}"
                    BorderBrush="#30443F"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="14"
                    Margin="0,0,0,14">
              <StackPanel>
                <TextBlock Text="SAFETY STATUS"
                           FontSize="9"
                           Foreground="{DynamicResource AccentBrush}"
                           FontWeight="SemiBold" />
                <TextBlock Text="{Binding SafetyText}"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Margin="0,7,0,0" />
              </StackPanel>
            </Border>

            <Border Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="14"
                    Margin="0,0,0,14">
              <StackPanel>
                <TextBlock Text="APP COLORS"
                          FontSize="9"
                          Foreground="{DynamicResource AccentBrush}"
                          FontWeight="SemiBold" />
                <TextBlock Text="Enter any six-digit RGB hex color. Valid colors preview immediately and save locally."
                          FontSize="10"
                          Foreground="{DynamicResource MutedBrush}"
                          TextWrapping="Wrap"
                          Margin="0,5,0,9" />

                <TextBlock Text="Accent"
                          FontSize="9"
                          Foreground="{DynamicResource MutedBrush}"
                          Margin="0,0,0,4" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="34" />
                    <ColumnDefinition Width="9" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="9" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Border Width="34"
                          Height="32"
                          Background="{DynamicResource AccentBrush}"
                          BorderBrush="{DynamicResource BorderBrush}"
                          BorderThickness="1"
                          CornerRadius="6" />
                  <TextBox Grid.Column="2"
                          AutomationProperties.AutomationId="AccentHexEditor"
                          Text="{Binding AppAccentHex, UpdateSourceTrigger=PropertyChanged}"
                          MaxLength="7" />
                  <Button Grid.Column="4"
                          AutomationProperties.AutomationId="SaveAccentButton"
                          Content="SAVE"
                          Command="{Binding SavePreferencesCommand}"
                          Padding="13,7" />
                </Grid>

                <TextBlock Text="Background"
                          FontSize="9"
                          Foreground="{DynamicResource MutedBrush}"
                          Margin="0,11,0,4" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="34" />
                    <ColumnDefinition Width="9" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="9" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Border Width="34"
                          Height="32"
                          Background="{DynamicResource WindowBrush}"
                          BorderBrush="{DynamicResource BorderBrush}"
                          BorderThickness="1"
                          CornerRadius="6" />
                  <TextBox Grid.Column="2"
                          AutomationProperties.AutomationId="BackgroundHexEditor"
                          Text="{Binding AppBackgroundHex, UpdateSourceTrigger=PropertyChanged}"
                          MaxLength="7" />
                  <Button Grid.Column="4"
                          AutomationProperties.AutomationId="SaveBackgroundButton"
                          Content="SAVE"
                          Command="{Binding SavePreferencesCommand}"
                          Padding="13,7" />
                </Grid>
              </StackPanel>
            </Border>

            <Border Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="14"
                    Margin="0,0,0,14">
              <StackPanel>
                <TextBlock Text="KEYBINDS"
                           FontSize="9"
                           Foreground="{DynamicResource AccentBrush}"
                           FontWeight="SemiBold" />
                <TextBlock Text="Shortcuts operate only from Home. Boost keys remain locked until the session is active."
                           FontSize="10"
                           Foreground="{DynamicResource MutedBrush}"
                           TextWrapping="Wrap"
                           Margin="0,5,0,10" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0">
                    <TextBlock Text="PREVIOUS PROFILE" FontSize="8" Foreground="{DynamicResource MutedBrush}" />
                    <ComboBox ItemsSource="{Binding ShortcutOptions}"
                              ItemTemplate="{StaticResource ShortcutOptionTemplate}"
                              SelectedValue="{Binding PreviousProfileKey}"
                              Margin="0,4,0,9" />
                    <TextBlock Text="TEMP QUICK HIT" FontSize="8" Foreground="{DynamicResource MutedBrush}" />
                    <ComboBox ItemsSource="{Binding ShortcutOptions}"
                              ItemTemplate="{StaticResource ShortcutOptionTemplate}"
                              SelectedValue="{Binding TemperatureBoostKey}"
                              Margin="0,4,0,0" />
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="NEXT PROFILE" FontSize="8" Foreground="{DynamicResource MutedBrush}" />
                    <ComboBox ItemsSource="{Binding ShortcutOptions}"
                              ItemTemplate="{StaticResource ShortcutOptionTemplate}"
                              SelectedValue="{Binding NextProfileKey}"
                              Margin="0,4,0,9" />
                    <TextBlock Text="TIME QUICK HIT" FontSize="8" Foreground="{DynamicResource MutedBrush}" />
                    <ComboBox ItemsSource="{Binding ShortcutOptions}"
                              ItemTemplate="{StaticResource ShortcutOptionTemplate}"
                              SelectedValue="{Binding TimeBoostKey}"
                              Margin="0,4,0,0" />
                  </StackPanel>
                </Grid>
                <Border Height="1" Background="{DynamicResource InputBorderBrush}" Margin="0,13,0,11" />
                <TextBlock Text="QUICK HIT AMOUNTS"
                           FontSize="9"
                           Foreground="{DynamicResource AccentBrush}"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding QuickHitTemperatureLabel}"
                               FontSize="8"
                               Foreground="{DynamicResource MutedBrush}" />
                    <TextBox Text="{Binding QuickHitTemperature, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,4,0,0" />
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="TIME INCREASE SEC"
                               FontSize="8"
                               Foreground="{DynamicResource MutedBrush}" />
                    <TextBox Text="{Binding QuickHitTimeSeconds, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,4,0,0" />
                  </StackPanel>
                </Grid>
                <TextBlock Text="Saved values are checked against the connected device limits again on every quick hit."
                           FontSize="9"
                           Foreground="{DynamicResource MutedBrush}"
                           TextWrapping="Wrap"
                           Margin="0,8,0,0" />
                <Button Content="SAVE CONTROL SETTINGS"
                        Command="{Binding SavePreferencesCommand}"
                        Margin="0,11,0,0" />
              </StackPanel>
            </Border>

            <Border Background="{DynamicResource PanelBrush}"
                    BorderBrush="#40574F"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="14"
                    Margin="0,0,0,14">
              <StackPanel>
                <TextBlock Text="SAFE E-RIG HANDOFF"
                           FontSize="9"
                           Foreground="{DynamicResource AccentBrush}"
                           FontWeight="SemiBold" />
                <TextBlock Text="Finds nearby Peak e-rigs only. Handoff is blocked during heat, releases the current base first, and requires normal Windows pairing plus Puffco authentication. It cannot seize a device from another connection."
                           FontSize="10"
                           Foreground="{DynamicResource MutedBrush}"
                           TextWrapping="Wrap"
                           Margin="0,6,0,10" />
                <Button AutomationProperties.AutomationId="HotSwapScanButton"
                        Content="FIND NEARBY E-RIGS"
                        Command="{Binding HotSwapScanCommand}"
                        Margin="0,0,0,8" />
                <ComboBox ItemsSource="{Binding HotSwapCandidates}"
                          SelectedItem="{Binding SelectedHotSwapCandidate}"
                          Margin="0,0,0,8">
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextBrush}" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding SignalStrength, StringFormat={}{0} dBm}"
                                   Foreground="{DynamicResource MutedBrush}"
                                   Margin="8,0,0,0" />
                      </Grid>
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <Button AutomationProperties.AutomationId="HotSwapConnectButton"
                        Content="HAND OFF TO SELECTED E-RIG"
                        Command="{Binding HotSwapConnectCommand}"
                        Background="{DynamicResource AccentBrush}"
                        Foreground="{DynamicResource AccentForegroundBrush}"
                        BorderBrush="{DynamicResource AccentBrush}" />
              </StackPanel>
            </Border>

            <Button Content="{Binding TemperatureUnitText}"
                    Command="{Binding ToggleTemperatureUnitCommand}"
                    Margin="0,0,0,10" />
            <Button Content="{Binding StealthButtonText}"
                    Command="{Binding ToggleStealthCommand}"
                    Margin="0,0,0,10" />
            <Button Content="{Binding LanternButtonText}"
                    Command="{Binding ToggleLanternCommand}"
                    Margin="0,0,0,10" />
            <Button Content="DISCONNECT DEVICE"
                    Command="{Binding DisconnectCommand}"
                    Foreground="#FF8D95"
                    Margin="0,10,0,0" />

            <TextBlock Text="desk_Puff never exposes firmware, bootloader, reset, raw-command, or arbitrary-file controls."
                       Foreground="{DynamicResource MutedBrush}"
                       FontSize="9"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Margin="20,18,20,0" />
          </StackPanel>
        </ScrollViewer>
      </Grid>

      <Border Grid.Row="2"
              BorderBrush="{DynamicResource RaisedBrush}"
              BorderThickness="0,1,0,0"
              CornerRadius="0,0,20,20"
              Background="{DynamicResource SunkenBrush}">
        <Grid Margin="16,8,16,9">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Button Grid.Column="0"
                  AutomationProperties.AutomationId="ProfilesNavButton"
                  Command="{Binding ShowProfilesCommand}"
                  Background="Transparent"
                  BorderThickness="0"
                  HorizontalAlignment="Center"
                  HorizontalContentAlignment="Center"
                  VerticalContentAlignment="Center"
                  Padding="6">
            <StackPanel HorizontalAlignment="Center">
              <Panel Height="26">
                <TextBlock Text="≡" FontSize="25" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Panel>
              <TextBlock Text="PROFILES" FontSize="9" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" Margin="0,3,0,0" />
            </StackPanel>
          </Button>
          <Button Grid.Column="1"
                  Command="{Binding ShowHomeCommand}"
                  Background="Transparent"
                  BorderThickness="0"
                  HorizontalAlignment="Center"
                  HorizontalContentAlignment="Center"
                  VerticalContentAlignment="Center"
                  Padding="6">
            <StackPanel HorizontalAlignment="Center">
              <Panel Height="26">
                <TextBlock Text="●" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Panel>
              <TextBlock Text="HOME" FontSize="9" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" Margin="0,3,0,0" />
            </StackPanel>
          </Button>
          <Button Grid.Column="2"
                  AutomationProperties.AutomationId="ColorNavButton"
                  Command="{Binding ShowColorCommand}"
                  Background="Transparent"
                  BorderThickness="0"
                  HorizontalAlignment="Center"
                  HorizontalContentAlignment="Center"
                  VerticalContentAlignment="Center"
                  Padding="6">
            <StackPanel HorizontalAlignment="Center">
              <Panel Height="26">
                <Ellipse Width="24" Height="24" VerticalAlignment="Center">
                  <Ellipse.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                      <GradientStop Color="#F80B00" Offset="0" />
                      <GradientStop Color="#6EE916" Offset="0.35" />
                      <GradientStop Color="#2878FF" Offset="0.7" />
                      <GradientStop Color="#E84DFF" Offset="1" />
                    </LinearGradientBrush>
                  </Ellipse.Fill>
                </Ellipse>
              </Panel>
              <TextBlock Text="COLOR" FontSize="9" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" Margin="0,3,0,0" />
            </StackPanel>
          </Button>
        </Grid>
      </Border>
      </Grid>
    </Viewbox>
  </Border>
</Window>
