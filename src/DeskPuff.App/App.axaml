<Application x:Class="DeskPuff.App.App"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             RequestedThemeVariant="Dark">
  <Application.Resources>
    <SolidColorBrush x:Key="WindowBrush" Color="#0B0C10" />
    <SolidColorBrush x:Key="PanelBrush" Color="#161920" />
    <SolidColorBrush x:Key="RaisedBrush" Color="#21252E" />
    <SolidColorBrush x:Key="TextBrush" Color="#F6F7F9" />
    <SolidColorBrush x:Key="MutedBrush" Color="#A9B0BC" />
    <SolidColorBrush x:Key="AccentBrush" Color="#BB376A" />
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#F6F7F9" />
    <SolidColorBrush x:Key="DangerBrush" Color="#F24D59" />
    <SolidColorBrush x:Key="SunkenBrush" Color="#111319" />
    <SolidColorBrush x:Key="SubtleBrush" Color="#1C2027" />
    <SolidColorBrush x:Key="BorderBrush" Color="#2B2F39" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="#30343F" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#303A3B" />
    <SolidColorBrush x:Key="HoverBrush" Color="#39404B" />
    <SolidColorBrush x:Key="ScrollBarBrush" Color="#171A20" />
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    <Style Selector="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="FontFamily" Value="avares://Avalonia.Fonts.Inter/Assets#Inter" />
    </Style>
    <Style Selector="Button">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="Background" Value="{DynamicResource RaisedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontFamily" Value="avares://Avalonia.Fonts.Inter/Assets#Inter" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="CornerRadius" Value="12" />
    </Style>
    <Style Selector="Button:pointerover">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="Button:pressed">
      <Setter Property="Opacity" Value="0.72" />
    </Style>
    <Style Selector="Button:disabled">
      <Setter Property="Opacity" Value="0.48" />
      <Setter Property="Cursor" Value="Arrow" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="Background" Value="{DynamicResource RaisedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
      <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="FontFamily" Value="avares://Avalonia.Fonts.Inter/Assets#Inter" />
      <Setter Property="FontSize" Value="11" />
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="Background" Value="{DynamicResource RaisedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontFamily" Value="avares://Avalonia.Fonts.Inter/Assets#Inter" />
      <Setter Property="MaxDropDownHeight" Value="230" />
    </Style>
    <Style Selector="ComboBoxItem">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="9,7" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="ComboBoxItem:selected">
      <Setter Property="Background" Value="{DynamicResource SelectionBrush}" />
    </Style>
    <Style Selector="ComboBoxItem:pointerover">
      <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
    </Style>
    <Style Selector="ScrollBar">
      <Setter Property="Background" Value="{DynamicResource ScrollBarBrush}" />
    </Style>
  </Application.Styles>
</Application>
